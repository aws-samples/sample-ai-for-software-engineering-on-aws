# The bench passes its SSH public key with -fw_cfg name=opt/cc1/authorized_keys,file=<key>. Only the bench has the
# private key: the agents reach the target through the bench tools, never over SSH.
[Unit]
Description=Install the bench's SSH key from QEMU fw_cfg
Before=dropbear.service
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/opt/cc1/authorized_keys/raw

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p /root/.ssh && chmod 700 /root/.ssh && cat /sys/firmware/qemu_fw_cfg/by_name/opt/cc1/authorized_keys/raw > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys'

[Install]
WantedBy=multi-user.target
