[Unit]
Description=vstatd vehicle status service
After=cc1-gwd.service

[Service]
Type=notify
ExecStart=/usr/bin/vstatd
User=vstat
Group=vstat
RuntimeDirectory=vstatd
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=1
MemoryMax=12M
TimeoutStopSec=2

[Install]
WantedBy=multi-user.target
